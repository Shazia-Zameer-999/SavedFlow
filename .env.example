FLASK_ENV=development
FLASK_SECRET_KEY=

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=savedflow

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# SavedFlow server used by the local Instagram sync helper.
# Local development example:
SAVEDFLOW_SERVER_URL=http://127.0.0.1:5002

# Your specific Instagram Saved collection.
INSTAGRAM_SAVED_URL=https://www.instagram.com/shaziazameer.dev/saved/dev/1087772466946333/

# Shared secret between the local sync helper and SavedFlow.
SAVEDFLOW_SYNC_TOKEN=

# How frequently the local helper checks for a requested sync.
SYNC_INTERVAL_SECONDS=60